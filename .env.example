# Production: set domain and strong passwords before docker compose up.
SITE_ADDRESS=wisdom.example.com
PUBLIC_ORIGIN=https://wisdom.example.com
# Optional contact information for your own Caddy issuer configuration.
ACME_EMAIL=
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Required in production: protects API keys and admin-saved OAuth secrets.
# Generate 32 random bytes as 64 hex characters; back up with the database.
# Development auto-creates .local/api-key-encryption.key when this is empty.
API_KEY_ENCRYPTION_KEY=
# Optional legacy OAuth defaults; use Admin > Third-party login to configure and enable.
# Explicit admin configuration takes precedence. Without credentials, login options stay hidden.
# Registered OAuth callback URLs: PUBLIC_ORIGIN/api/auth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# Direct Node development only; Docker supplies its own connection string.
DATABASE_URL=postgresql://wisdom:password@localhost:5432/wisdom
DATABASE_MODE=postgres
PGLITE_PATH=.local/preview-db
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DB_POOL_MAX=5
# Version and repository for the header update indicator. CI supplies RELEASE_ID.
# Direct Node/source deployments may set APP_VERSION to their full Git commit SHA.
APP_VERSION=
UPDATE_REPOSITORY=vow132/wisdom-tree
UPDATE_BRANCH=codex/wisdom-tree
# Configure the repository-specific Actions token in Admin > System rules > Website update.
# Fork deployments must use their OWN configured deployment repository above.
